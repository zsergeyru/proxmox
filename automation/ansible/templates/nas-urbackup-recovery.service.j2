[Unit]
Description=Encrypted UrBackup server state on verified NAS backup disk
After=network-online.target
RequiresMountsFor={{ nas_backup_mountpoint }}

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/nas-urbackup-recovery backup
ExecStartPost=/usr/local/sbin/nas-urbackup-recovery verify
TimeoutStartSec=1h
