# Настройки создаются из Git, маршруты — из постоянного management/routes.yaml.
# Файл sites.generated.caddy пересоздаётся при каждом развёртывании.
# Административный API остаётся только на локальном сокете Caddy внутри
# контейнера; наружу порт 2019 не публикуется. Это нужно для caddy reload.
import sites.generated.caddy

# Временная домашняя страница работает только по HTTP на отдельном порту.
# Она не использует Homarr, OIDC или сертификаты и не открывает /init.
:8080 {
    @local_network remote_ip {{ provision.web_gateway.caddy.private_networks | join(' ') }}
    handle @local_network {
        root * /etc/caddy/local-home
        file_server
        header Cache-Control "no-store"
        header X-Content-Type-Options "nosniff"
    }
    handle {
        respond "Доступ только из домашней сети" 403
    }
}

# Только внутренняя сеть Docker; порт 8081 не опубликован на узле.
# Homarr читает машинный каталог из Git без дополнительной службы.
:8081 {
    @management path /management/*
    handle @management {
        # Доступно только Homarr в сети Docker, без опубликованного порта.
        # Дополнительно Python проверяет сохранённый закрытый ключ.
        reverse_proxy unix//run/admin-control/control.sock
    }
    @catalog path /guests.json
    handle @catalog {
        root * /srv/homarr-catalog
        header Cache-Control "no-store"
        file_server
    }
    respond "Not Found" 404
}
