# Управляемые маршруты. Источник — постоянный management/routes.yaml.
# Старые маршруты без access: публичны только имена из разрешённого списка;
# остальные требуют входа. Это позволяет безопасно обновить существующий mp0.
{% for route in web_gateway_routes if route.enabled | default(false) | bool %}
{% set access = route.access | default('public' if route.domain in provision.web_gateway.caddy.public_domains else 'protected') %}
{{ route.domain }} {
    encode zstd gzip
{% if access == 'protected' %}
    # Служба получает запрос только после подтверждения второго фактора.
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
    reverse_proxy {{ route.upstream }}
{% elif access == 'app_auth' %}
    # Приложение само проверяет вход; запросы мобильных клиентов не перехватываем.
    reverse_proxy {{ route.upstream }}
{% elif access == 'private' %}
    # Сравниваем исходный адрес TCP-соединения; подложные заголовки не доверены.
    @private_network remote_ip {{ provision.web_gateway.caddy.private_networks | join(' ') }}
    handle @private_network {
        reverse_proxy {{ route.upstream }}
    }
    handle {
        respond "Доступ только из домашней сети" 403
    }
{% elif route.domain == provision.web_gateway.authelia.public_url.split('://', 1)[1] %}
    # Временная страница не требует пароля и существует только пока
    # работает не включённая в автозапуск служба (максимум 15 минут).
    @totp_setup path /totp-setup /totp-setup/*
    handle @totp_setup {
        @totp_lan remote_ip {{ provision.web_gateway.caddy.private_networks | join(' ') }}
        handle @totp_lan {
            reverse_proxy unix//run/totp-setup/setup.sock
        }
        handle {
            respond "Доступ только из домашней сети" 403
        }
    }
    handle {
        reverse_proxy {{ route.upstream }}
    }
{% elif route.domain == provision.web_gateway.portal.public_url.split('://', 1)[1] %}
    # Каждая страница и запрос проверяются Authelia: пароль + TOTP.
    # /admin и /api/admin дополнительно требуют домашнюю сеть и группу admins.
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Cache-Control "no-store"
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"
    }
    @setup_denied path /init /init/* /api/onboarding/* /api/trpc/onboard.* /api/trpc/group.createInitialExternalGroup*
    @admin_ui_lan {
        path /admin /admin/*
        remote_ip {{ provision.web_gateway.caddy.private_networks | join(' ') }}
    }
    @admin_api_lan {
        path /api/admin/*
        remote_ip {{ provision.web_gateway.caddy.private_networks | join(' ') }}
    }
    @admin_ui path /admin /admin/*
    @admin_api path /api/admin/*
    @applications path /api/apps
    @static path /static/portal.css /static/portal.js
    route {
        respond @setup_denied "Not Found" 404
        handle @admin_api_lan {
            route {
                forward_auth authelia:9091 {
                    uri /api/authz/forward-auth
                }
                reverse_proxy unix//run/portal/portal.sock {
                    # Всегда заменять клиентский заголовок после проверки Authelia.
                    header_up X-Portal-Verified admin
                    header_up -Authorization
                }
            }
        }
        handle @admin_api {
            respond "Администрирование доступно только из домашней сети/VPN" 403
        }
        handle @admin_ui_lan {
            route {
                forward_auth authelia:9091 {
                    uri /api/authz/forward-auth
                }
                rewrite * /portal-admin.html
                root * /etc/caddy/portal
                file_server
            }
        }
        handle @admin_ui {
            respond "Администрирование доступно только из домашней сети/VPN" 403
        }
        handle @applications {
            route {
                forward_auth authelia:9091 {
                    uri /api/authz/forward-auth
                }
                reverse_proxy unix//run/portal/portal.sock {
                    header_up X-Portal-Verified home
                    header_up -Authorization
                }
            }
        }
        handle @static {
            route {
                forward_auth authelia:9091 {
                    uri /api/authz/forward-auth
                }
                uri strip_prefix /static
                root * /etc/caddy/portal
                file_server
            }
        }
        handle {
            route {
                forward_auth authelia:9091 {
                    uri /api/authz/forward-auth
                }
                rewrite * /portal-home.html
                root * /etc/caddy/portal
                file_server
            }
        }
    }
{% else %}
    reverse_proxy {{ route.upstream }}
{% endif %}
}

{% endfor %}