# Управляемые маршруты. Источник — постоянный management/routes.yaml.
# Старые маршруты без access: публичны только имена из разрешённого списка;
# остальные требуют входа. Это позволяет безопасно обновить существующий mp0.
{% for route in web_gateway_routes if route.enabled | default(false) | bool %}
{% set access = route.access | default('public' if route.domain in provision.web_gateway.caddy.public_domains else 'protected') %}
{{ route.domain }} {
    encode zstd gzip
{% if access == 'protected' %}
    # Служба получает запрос только после подтверждения второго фактора.
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
    reverse_proxy {{ route.upstream }}
{% elif access == 'private' %}
    # Сравниваем исходный адрес TCP-соединения; подложные заголовки не доверены.
    @private_network remote_ip {{ provision.web_gateway.caddy.private_networks | join(' ') }}
    handle @private_network {
        reverse_proxy {{ route.upstream }}
    }
    handle {
        respond "Доступ только из домашней сети" 403
    }
{% elif route.domain == provision.web_gateway.authelia.public_url.split('://', 1)[1] %}
    # Начальная привязка Google Authenticator — только для администратора
    # по паролю через Authelia и только из домашней сети.
    @totp_setup path /totp-setup /totp-setup/*
    handle @totp_setup {
        @totp_lan remote_ip {{ provision.web_gateway.caddy.private_networks | join(' ') }}
        handle @totp_lan {
            forward_auth authelia:9091 {
                uri /api/authz/forward-auth
            }
            @totp_qr path /totp-setup/qr.png
            handle @totp_qr {
                rewrite * /admin.png
                root * {{ provision.web_gateway.authelia.totp_setup.qr_caddy_root }}
                header Cache-Control "no-store"
                header X-Content-Type-Options "nosniff"
                file_server
            }
            handle {
                rewrite * /index.html
                root * /etc/caddy/totp-setup
                header Cache-Control "no-store"
                header X-Content-Type-Options "nosniff"
                file_server
            }
        }
        handle {
            respond "Доступ только из домашней сети" 403
        }
    }
    handle {
        reverse_proxy {{ route.upstream }}
    }
{% elif route.domain == provision.web_gateway.homarr.public_url.split('://', 1)[1] %}
    # Никакой посетитель не должен открывать мастер первичного администратора.
    # Готовность устанавливается только после штатной инициализации Homarr.
    @onboarding path /init /init/* /*/init /*/init/* /api/onboarding/* /api/trpc/onboard.* /api/trpc/group.createInitialExternalGroup* /api/trpc/user.initUser*
    @homarr_ready file {
        root /srv/homarr-catalog
        try_files /homarr-ready
    }
    route {
        respond @onboarding "Not Found" 404
        handle @homarr_ready {
            reverse_proxy {{ route.upstream }}
        }
        handle {
            respond "Homarr ещё не настроен" 503
        }
    }
{% else %}
    reverse_proxy {{ route.upstream }}
{% endif %}
}

{% endfor %}