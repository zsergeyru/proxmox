# Воспроизводимая конфигурация. Секреты берутся из постоянного /run/authelia-secrets.
server:
  address: "tcp://:{{ provision.web_gateway.authelia.internal_port }}"

log:
  level: info

totp:
  issuer: "{{ provision.web_gateway.domain }}"

authentication_backend:
  password_reset:
    # Пока уведомления пишутся только в файл, восстановление по почте выключено.
    disable: true
  password_change:
    disable: false
  file:
    path: /data/users_database.yml
    watch: true
    password:
      algorithm: argon2
      argon2:
        variant: argon2id

access_control:
  default_policy: deny
  # Без единого правила Authelia отвергает политику запрета по умолчанию.
  # Caddy проверяет каждую защищённую службу через Authelia.
  # Правило для всех поддоменов позволяет добавлять маршруты из routes.yaml,
  # но не делает их публичными: в Caddy допуск определяется отдельно.
  rules:
    - domain: "*.{{ provision.web_gateway.domain }}"
      policy: two_factor

session:
  cookies:
    - name: authelia_session
      domain: "{{ provision.web_gateway.domain }}"
      authelia_url: "{{ provision.web_gateway.authelia.public_url }}"
      default_redirection_url: "{{ provision.web_gateway.homarr.public_url }}"

regulation:
  max_retries: 5
  find_time: 2 minutes
  ban_time: 5 minutes

storage:
  local:
    path: "{{ provision.web_gateway.authelia.storage.container_path }}"

notifier:
  filesystem:
    filename: /data/notifications.txt

identity_providers:
  oidc:
    # Authelia обрабатывает эти конструкции своим template-фильтром.
    # Не раскрывать значения при работе Ansible.
    jwks:
      - key: {% raw %}{{ secret "/run/authelia-secrets/authelia-oidc-jwks-pem" | mindent 10 "|" | msquote }}{% endraw +%}
    clients:
      - client_id: "{{ provision.web_gateway.homarr.authentication.client_id }}"
        client_name: Homarr
        client_secret: {% raw %}{{ secret "/run/authelia-secrets/authelia-homarr-client-secret-hash" }}{% endraw +%}
        public: false
        authorization_policy: two_factor
        consent_mode: implicit
        token_endpoint_auth_method: client_secret_basic
        redirect_uris:
          - "{{ provision.web_gateway.homarr.public_url }}/api/auth/callback/oidc"
        scopes:
          - openid
          - profile
          - email
          - groups
        userinfo_signed_response_alg: none
        response_types:
          - code
        grant_types:
          - authorization_code
      - client_id: immich
        client_name: Immich
        client_secret: {% raw %}{{ secret "/run/authelia-secrets/authelia-immich-client-secret-hash" }}{% endraw +%}
        public: false
        authorization_policy: two_factor
        require_pkce: true
        pkce_challenge_method: S256
        token_endpoint_auth_method: client_secret_basic
        redirect_uris:
          - https://photos.zsergey.ru/auth/login
          - https://photos.zsergey.ru/user-settings
          - app.immich:///oauth-callback
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
