# Все уникальные данные находятся на mp0. Не использовать docker compose down -v.
services:
  caddy:
    image: "{{ provision.web_gateway.caddy.image }}"
    container_name: "{{ provision.web_gateway.caddy.container_name }}"
    restart: unless-stopped
    ports:
      - "{{ provision.web_gateway.caddy.listen.http }}:80"
      - "{{ provision.web_gateway.caddy.listen.https }}:443"
      # Отдельный домашний HTTP-вход без публичного имени и TLS.
      - "{{ provision.web_gateway.caddy.listen.local_http }}:8080"
    volumes:
      - "{{ provision.web_gateway.paths.configuration }}/caddy:/etc/caddy:ro"
      - "{{ provision.web_gateway.portal.assets }}:/etc/caddy/portal:ro"
      - "{{ provision.web_gateway.paths.persistent_state }}/management/portal-socket:/run/portal:ro"
      - "{{ provision.web_gateway.paths.persistent_state }}/management/catalog:/srv/homarr-catalog:ro"
      # Только Unix-сокет временной страницы, никаких секретов Authelia.
      - "{{ provision.web_gateway.paths.persistent_state }}/management/totp-setup-socket:/run/totp-setup:ro"
      - "{{ provision.web_gateway.paths.persistent_state }}/management/admin-socket:/run/admin-control:ro"
      - "{{ provision.web_gateway.caddy.data.host }}:{{ provision.web_gateway.caddy.data.container }}"
      - "{{ provision.web_gateway.caddy.config.host }}:{{ provision.web_gateway.caddy.config.container }}"
    depends_on:
      - authelia

  authelia:
    image: "{{ provision.web_gateway.authelia.image }}"
    container_name: "{{ provision.web_gateway.authelia.container_name }}"
    restart: unless-stopped
    environment:
      TZ: Europe/Moscow
      X_AUTHELIA_CONFIG_FILTERS: template
      AUTHELIA_SESSION_SECRET_FILE: /run/authelia-secrets/authelia-session-secret
      AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE: /run/authelia-secrets/authelia-storage-encryption-key
      AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE: /run/authelia-secrets/authelia-jwt-secret
      AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET_FILE: /run/authelia-secrets/authelia-oidc-hmac-secret
    volumes:
      - "{{ provision.web_gateway.paths.configuration }}/authelia:/config:ro"
      - "{{ provision.web_gateway.paths.secrets }}:/run/authelia-secrets:ro"
      - "{{ provision.web_gateway.authelia.data.host }}:{{ provision.web_gateway.authelia.data.container }}"
