#information-widgets {
  display: none;
}

#layout-groups {
  width: calc(100% - 2rem);
  max-width: 1360px;
  margin-left: auto !important;
  margin-right: auto !important;
  padding-top: clamp(2rem, 5vw, 4rem);
  padding-bottom: 2rem;
  gap: 1.25rem;
}

#layout-groups::before {
  content: {{ provision.portal.local.title | to_json }};
  display: block;
  flex-basis: 100%;
  width: 100%;
  margin: 0 auto 1.25rem;
  padding-bottom: 1.25rem;
  text-align: center;
  color: #f0f9ff;
  font-size: clamp(2rem, 4vw, 3.25rem);
  font-weight: 750;
  letter-spacing: 0.01em;
  line-height: 1.08;
  text-shadow:
    0 0 16px rgba(56, 189, 248, 0.35),
    0 0 42px rgba(37, 99, 235, 0.2);
  background:
    linear-gradient(
      90deg,
      transparent 0%,
      rgba(14, 165, 233, 0.12) 24%,
      rgba(56, 189, 248, 0.9) 49%,
      rgba(14, 165, 233, 0.12) 76%,
      transparent 100%
    )
    bottom center / min(560px, 72%) 2px no-repeat;
}

#layout-groups .services-group,
#layout-groups .bookmark-group {
  position: relative;
  overflow: visible;
  padding: 1.35rem 1.5rem 1.2rem;
  border: 1px solid rgba(14, 165, 233, 0.72);
  border-radius: 1.35rem;
  background:
    linear-gradient(145deg, rgba(3, 16, 38, 0.82), rgba(5, 20, 48, 0.66));
  box-shadow:
    inset 0 1px 0 rgba(125, 211, 252, 0.07),
    inset 0 0 28px rgba(37, 99, 235, 0.08),
    0 0 0 1px rgba(2, 132, 199, 0.1),
    0 14px 40px rgba(2, 8, 23, 0.36),
    0 0 28px rgba(14, 165, 233, 0.08);
}

#layout-groups .services-group::after,
#layout-groups .bookmark-group::after {
  content: "";
  pointer-events: none;
  position: absolute;
  inset: 0.55rem;
  border-radius: 1rem;
  background:
    radial-gradient(circle at 92% 8%, rgba(14, 165, 233, 0.11), transparent 22%),
    repeating-linear-gradient(
      120deg,
      transparent 0 22px,
      rgba(56, 189, 248, 0.018) 22px 23px
    );
  z-index: -1;
}

#layout-groups .services-group > button,
#layout-groups .bookmark-group > button {
  position: relative;
  z-index: 2;
  padding: 0 0.15rem 0.6rem;
}

#layout-groups .service-group-name,
#layout-groups .bookmark-group-name {
  color: #eaf6ff;
  font-size: clamp(1.35rem, 2vw, 1.75rem);
  font-weight: 700;
  text-shadow: 0 0 14px rgba(56, 189, 248, 0.16);
}

#layout-groups .service-group-icon,
#layout-groups .bookmark-group-icon {
  width: 2rem;
  height: 2rem;
  margin-right: 0.8rem;
  filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.5));
}

#layout-groups .services-list {
  gap: 0.95rem;
}

#layout-groups .service-card {
  min-height: 92px;
  padding: 0.65rem 0.75rem;
  border: 1px solid rgba(34, 211, 238, 0.86);
  border-radius: 1rem;
  background:
    linear-gradient(135deg, rgba(3, 30, 64, 0.82), rgba(4, 18, 45, 0.74));
  box-shadow:
    inset 0 0 24px rgba(14, 165, 233, 0.08),
    0 0 0 1px rgba(56, 189, 248, 0.08),
    0 0 20px rgba(14, 165, 233, 0.12);
}

#layout-groups .service-card:hover {
  border-color: rgba(103, 232, 249, 0.98);
  background:
    linear-gradient(135deg, rgba(4, 40, 82, 0.9), rgba(5, 24, 58, 0.82));
  box-shadow:
    inset 0 0 28px rgba(14, 165, 233, 0.12),
    0 0 26px rgba(34, 211, 238, 0.2);
  transform: translateY(-1px);
}

#layout-groups .service-title {
  min-height: 72px;
  align-items: center;
}

#layout-groups .service-icon {
  width: 4.25rem;
}

#layout-groups .service-icon > div,
#layout-groups .service-icon img,
#layout-groups .service-icon svg {
  width: 2.45rem !important;
  height: 2.45rem !important;
  filter: drop-shadow(0 0 9px rgba(56, 189, 248, 0.48));
}

#layout-groups .service-name {
  color: #f8fbff;
  font-size: 1.08rem;
  font-weight: 700;
  padding: 0.75rem 0.55rem;
}

#layout-groups .service-description {
  margin-top: 0.15rem;
  color: #9fb8d2;
  font-size: 0.82rem;
  font-weight: 400;
}

#layout-groups .service-site-monitor {
  margin: 0.95rem 0.95rem 0 0;
  filter: drop-shadow(0 0 7px rgba(16, 185, 129, 0.65));
}

#layout-groups .bookmark {
  position: relative;
}

#layout-groups .bookmark > a {
  position: relative;
  min-height: 88px;
  overflow: hidden;
  border: 1px solid rgba(56, 189, 248, 0.55);
  border-radius: 1rem;
  background:
    linear-gradient(135deg, rgba(6, 24, 54, 0.92), rgba(5, 17, 40, 0.8));
  box-shadow:
    inset 0 0 22px rgba(14, 165, 233, 0.06),
    0 0 16px rgba(14, 165, 233, 0.08);
}

#layout-groups .bookmark > a > .flex {
  min-height: 88px;
}

#layout-groups .bookmark > a::after {
  content: "Гость {{ provision.guest_vmid }}";
  position: absolute;
  right: 0.85rem;
  top: 50%;
  transform: translateY(-50%);
  padding: 0.25rem 0.55rem;
  border: 1px solid rgba(148, 163, 184, 0.38);
  border-radius: 0.55rem;
  color: #cbd5e1;
  background: rgba(15, 23, 42, 0.58);
  font-size: 0.72rem;
  line-height: 1.1;
  box-shadow: inset 0 0 10px rgba(148, 163, 184, 0.05);
}

#layout-groups .bookmark-icon {
  width: 4.35rem;
  background: rgba(2, 8, 23, 0.28);
}

#layout-groups .bookmark-icon > div,
#layout-groups .bookmark-icon img,
#layout-groups .bookmark-icon svg {
  width: 2.15rem !important;
  height: 2.15rem !important;
}

#layout-groups .bookmark-text {
  padding-right: 5.4rem;
}

#layout-groups .bookmark-name {
  color: #f8fbff;
  font-size: 0.98rem;
  font-weight: 700;
  padding: 0.8rem 0 0.15rem 0.8rem;
}

#layout-groups .bookmark-description {
  position: absolute;
  left: 5.15rem;
  bottom: 0.72rem;
  padding: 0;
  color: #9fb8d2;
  font-size: 0.76rem;
  font-weight: 400;
}

#layout-groups .bookmark:nth-child(1) > a {
  border-color: rgba(52, 211, 153, 0.9);
  box-shadow:
    inset 0 0 24px rgba(16, 185, 129, 0.08),
    0 0 22px rgba(16, 185, 129, 0.16);
}

#layout-groups .bookmark:nth-child(1) .bookmark-icon {
  color: #34d399;
  background: linear-gradient(135deg, rgba(6, 78, 59, 0.38), rgba(2, 44, 34, 0.2));
}

#layout-groups .bookmark:nth-child(2) > a {
  border-color: rgba(56, 189, 248, 0.9);
  box-shadow:
    inset 0 0 24px rgba(37, 99, 235, 0.1),
    0 0 22px rgba(37, 99, 235, 0.18);
}

#layout-groups .bookmark:nth-child(2) .bookmark-icon {
  color: #38bdf8;
  background: linear-gradient(135deg, rgba(30, 64, 175, 0.36), rgba(8, 47, 73, 0.22));
}

#layout-groups .bookmark:nth-child(3) > a {
  border-color: rgba(251, 146, 60, 0.92);
  box-shadow:
    inset 0 0 24px rgba(249, 115, 22, 0.08),
    0 0 22px rgba(249, 115, 22, 0.17);
}

#layout-groups .bookmark:nth-child(3) .bookmark-icon {
  color: #fb923c;
  background: linear-gradient(135deg, rgba(124, 45, 18, 0.38), rgba(67, 20, 7, 0.22));
}

#layout-groups .bookmark > a:hover {
  transform: translateY(-1px);
  filter: brightness(1.08);
}

#footer {
  max-width: 1360px;
  margin-left: auto;
  margin-right: auto;
}

#footer #style {
  opacity: 0.78;
}

@media (max-width: 800px) {
  #layout-groups {
    width: calc(100% - 1rem);
    padding-top: 1.2rem;
  }

  #layout-groups::before {
    font-size: 2rem;
    margin-bottom: 0.65rem;
  }

  #layout-groups .services-group,
  #layout-groups .bookmark-group {
    padding: 1rem;
    border-radius: 1rem;
  }

  #layout-groups .services-list,
  #layout-groups .bookmark-group ul {
    grid-template-columns: 1fr !important;
  }

  #layout-groups .bookmark > a::after {
    display: none;
  }

  #layout-groups .bookmark-text {
    padding-right: 0;
  }
}

@media (min-width: 640px) {
  #layout-groups {
    width: calc(100% - 4rem);
  }
}
