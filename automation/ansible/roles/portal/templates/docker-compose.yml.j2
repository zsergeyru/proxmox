services:
  homepage:
    image: {{ portal_homepage_image }}
    container_name: homepage
    restart: unless-stopped
    ports:
      - "{{ portal_local_port }}:3000"
    environment:
      HOMEPAGE_ALLOWED_HOSTS: "{{ inventory_hostname }}:{{ portal_local_port }},localhost:{{ portal_local_port }},127.0.0.1:{{ portal_local_port }}"
{% if portal_trusted_ca | default('') | length > 0 %}
      NODE_EXTRA_CA_CERTS: /etc/ssl/homepage/trusted-ca.crt
{% endif %}
    volumes:
      - "{{ portal_config_dir }}:/app/config"
      - "{{ portal_images_dir }}:/app/public/images:ro"
{% if portal_trusted_ca | default('') | length > 0 %}
      - "{{ portal_trusted_ca }}:/etc/ssl/homepage/trusted-ca.crt:ro"
{% endif %}
