services:
  immich-server:
    image: ghcr.io/immich-app/immich-server:{{ provision.photo_archive.immich_version }}
    container_name: immich_server
    restart: unless-stopped
    ports:
      - "{{ provision.photo_archive.web_port }}:2283"
    env_file:
      - {{ provision.photo_archive.paths.environment }}
    environment:
      # Пока Windows не настроен, миниатюры и сканирование выполняет сам 340.
      IMMICH_WORKERS_INCLUDE: "{{ 'api' if provision.photo_archive.remote_worker.enabled else 'api,microservices' }}"
      DB_HOSTNAME: database
      REDIS_HOSTNAME: redis
    volumes:
      - {{ provision.photo_archive.paths.uploads }}:/data
      - {{ provision.photo_archive.paths.originals }}:/external/originals{{ ':ro' if provision.photo_archive.storage.originals_read_only else '' }}
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      - database
      - redis

  database:
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
    container_name: immich_postgres
    restart: unless-stopped
    shm_size: 128mb
{% if provision.photo_archive.remote_worker.enabled %}
    # Открывается только при готовом отдельном обработчике Windows.
    ports:
      - "{{ ansible_host }}:5432:5432"
{% endif %}
    env_file:
      - {{ provision.photo_archive.paths.environment }}
    environment:
      POSTGRES_USER: postgres
      POSTGRES_DB: immich
      POSTGRES_INITDB_ARGS: '--data-checksums'
    volumes:
      - {{ provision.photo_archive.paths.database }}:/var/lib/postgresql/data

  redis:
    # Пароль сохраняется на постоянном томе с параметрами Immich.
    command: ["/bin/sh", "-c", "exec valkey-server --requirepass \"$$REDIS_PASSWORD\""]
    env_file:
      - {{ provision.photo_archive.paths.environment }}
{% if provision.photo_archive.remote_worker.enabled %}
    ports:
      - "{{ ansible_host }}:6379:6379"
{% endif %}
    image: docker.io/valkey/valkey:9@sha256:c123e3715db63d06d4ad6964884037aa0d5d4d703939b9929954112889708e1d
    container_name: immich_redis
    restart: unless-stopped

  # Воспоминания готовятся сразу; уведомления требуют последующей настройки ntfy.
  immich-memories:
    image: {{ provision.photo_archive.addons.memories.image }}
    container_name: immich_memories
    restart: unless-stopped
{% if not provision.photo_archive.addons.memories.enabled %}
    profiles: ["disabled-addons"]
{% endif %}
    ports:
      - "{{ ansible_host }}:{{ provision.photo_archive.addons.memories.web_port }}:5000"
    env_file:
      - /mnt/persistent-state/secrets/immich-memories.env
    environment:
      CONFIG_PATH: /app/config.yaml
      STATE_PATH: /app/state/state.json
      ENV_PATH: /app/.env
    volumes:
      - /mnt/persistent-state/addons/memories/config.yaml:/app/config.yaml
      - /mnt/persistent-state/addons/memories/state:/app/state
      - /mnt/persistent-state/secrets/immich-memories.env:/app/.env
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      - immich-server

  # Подключение к PostgreSQL только внутри сети Compose, без публикации порта.
  immich-power-tools:
    image: {{ provision.photo_archive.addons.power_tools.image }}
    container_name: immich_power_tools
    restart: unless-stopped
{% if not provision.photo_archive.addons.power_tools.enabled %}
    profiles: ["disabled-addons"]
{% endif %}
    ports:
      - "{{ ansible_host }}:{{ provision.photo_archive.addons.power_tools.web_port }}:3000"
    env_file:
      - {{ provision.photo_archive.paths.environment }}
      - /mnt/persistent-state/secrets/immich-power-tools.env
    volumes:
      - /mnt/persistent-state/addons/power-tools/data:/app/data
    depends_on:
      - immich-server
      - database

  # Пока LM Studio не настроена, служба остаётся выключенной.
  immich-analyze:
    image: {{ provision.photo_archive.addons.analyze.image }}
    container_name: immich_analyze
    restart: unless-stopped
{% if not provision.photo_archive.addons.analyze.enabled %}
    profiles: ["disabled-addons"]
{% endif %}
    env_file:
      - /mnt/persistent-state/secrets/immich-analyze.env
    depends_on:
      - immich-server
