[Unit]
Description=UrBackup Server on verified NAS backup ZFS pool
Requires=docker.service
After=docker.service
RequiresMountsFor={{ nas_backup_mountpoint }}
ConditionPathExists=/etc/nas-apps/urbackup/initialized

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/nas-urbackup-safe preflight
ExecStart=/usr/bin/docker compose -f /etc/nas-apps/urbackup/compose.yml up --no-color --abort-on-container-exit
ExecStop=/usr/bin/docker compose -f /etc/nas-apps/urbackup/compose.yml down
Restart=no
TimeoutStartSec=240
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
