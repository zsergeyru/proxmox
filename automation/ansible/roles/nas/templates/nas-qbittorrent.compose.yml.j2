# Управляет Infra Manager; запуск только через systemd-проверку тома.
services:
  qbittorrent:
    image: "{{ nas_qbit_image }}"
    container_name: "{{ nas_provision.services.qbittorrent.container }}"
    environment:
      PUID: "{{ nas_qbit_uid.stdout }}"
      PGID: "{{ nas_qbit_gid.stdout }}"
      TZ: "{{ nas_provision.services.qbittorrent.runtime.timezone }}"
      WEBUI_PORT: "{{ nas_provision.services.qbittorrent.runtime.web_port }}"
      TORRENTING_PORT: "{{ nas_provision.services.qbittorrent.runtime.torrent_port }}"
    volumes:
      - type: bind
        source: /var/lib/nas-apps/qbittorrent/config
        target: /config
        bind:
          create_host_path: false
      - type: bind
        source: "{{ nas_shared_mount }}/{{ nas_provision.services.qbittorrent.runtime.downloads_directory }}"
        target: /downloads
        bind:
          create_host_path: false
    ports:
      - "{{ nas_provision.services.qbittorrent.runtime.web_port }}:{{ nas_provision.services.qbittorrent.runtime.web_port }}"
      - "{{ nas_provision.services.qbittorrent.runtime.torrent_port }}:{{ nas_provision.services.qbittorrent.runtime.torrent_port }}/tcp"
      - "{{ nas_provision.services.qbittorrent.runtime.torrent_port }}:{{ nas_provision.services.qbittorrent.runtime.torrent_port }}/udp"
    restart: "no"
