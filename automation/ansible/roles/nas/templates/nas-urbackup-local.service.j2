[Unit]
Description=Consistent NAS ZFS snapshot to local UrBackup Server
Requires=nas-urbackup.service nas-urbackup-client.service
After=nas-urbackup.service nas-urbackup-client.service
RequiresMountsFor={{ nas_data_mountpoint }} {{ nas_backup_mountpoint }}

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/nas-urbackup-snapshot
TimeoutStartSec=8h
Nice=10
IOSchedulingClass=best-effort
