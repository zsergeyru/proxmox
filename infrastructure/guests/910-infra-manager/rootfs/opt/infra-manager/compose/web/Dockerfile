FROM python:3.12.12-alpine3.21

ARG INFRA_GIT_REVISION=unknown
ARG INFRA_WEB_CONTENT_REVISION=unknown
ENV INFRA_WEB_BUILD_GIT_REVISION=${INFRA_GIT_REVISION}
ENV INFRA_WEB_BUILD_REVISION=${INFRA_WEB_CONTENT_REVISION}

WORKDIR /opt/infra-web
COPY --chmod=0444 app.py admin.py diagnostics.js ui.js ui.css /opt/infra-web/

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python3", "/opt/infra-web/admin.py"]
