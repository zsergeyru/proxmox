[Unit]
Description=Разблокировка OpenBao после запуска infra-manager
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/infra-manager-openbao-startup-unseal {{ infra_pve_node }}
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
