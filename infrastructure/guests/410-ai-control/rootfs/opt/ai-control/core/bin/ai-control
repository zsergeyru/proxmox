#!/usr/bin/python3
"""Минимальное ядро AI Control: веб-интерфейс, API, задачи и память."""

from __future__ import annotations

import base64
import hmac
import json
import os
import sqlite3
import sys
import threading
import uuid
from datetime import UTC, datetime
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse

VERSION = "0.1.0"
MAX_BODY_BYTES = 1024 * 1024


def utc_now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds")


def env(name: str, default: str | None = None) -> str:
    value = os.environ.get(name, default)
    if value is None or value == "":
        raise RuntimeError(f"Не задана переменная {name}")
    return value


class Settings:
    def __init__(self) -> None:
        self.state = Path(env("AI_CONTROL_STATE", "/opt/ai-control/state"))
        self.web_root = Path(
            env("AI_CONTROL_WEB_ROOT", "/opt/ai-control/core/web")
        )
        self.models_file = Path(
            env("AI_CONTROL_MODELS_FILE", "/etc/ai-control/models.json")
        )
        self.tools_file = Path(
            env("AI_CONTROL_TOOLS_FILE", "/etc/ai-control/tools.json")
        )
        self.primary_agent = env("AI_CONTROL_PRIMARY_AGENT", "hermes")
        self.listen = env("AI_CONTROL_WEB_LISTEN", "0.0.0.0")
        self.port = int(env("AI_CONTROL_WEB_PORT", "4100"))
        self.web_user = env("AI_CONTROL_WEB_USER")
        self.web_password = env("AI_CONTROL_WEB_PASSWORD")
        self.database = self.state / "ai-control.sqlite3"


class Store:
    def __init__(self, path: Path) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        self.path = path
        self._lock = threading.RLock()
        self._initialize()

    def connect(self) -> sqlite3.Connection:
        connection = sqlite3.connect(self.path, timeout=10)
        connection.row_factory = sqlite3.Row
        return connection

    def _initialize(self) -> None:
        with self._lock, self.connect() as db:
            db.executescript(
                """
                PRAGMA journal_mode=WAL;
                CREATE TABLE IF NOT EXISTS tasks (
                    id TEXT PRIMARY KEY,
                    created_at TEXT NOT NULL,
                    updated_at TEXT NOT NULL,
                    title TEXT NOT NULL,
                    description TEXT NOT NULL,
                    status TEXT NOT NULL,
                    agent TEXT NOT NULL,
                    model TEXT,
                    result TEXT,
                    error TEXT
                );
                CREATE TABLE IF NOT EXISTS memory (
                    id TEXT PRIMARY KEY,
                    created_at TEXT NOT NULL,
                    updated_at TEXT NOT NULL,
                    category TEXT NOT NULL,
                    key TEXT NOT NULL,
                    value TEXT NOT NULL,
                    UNIQUE(category, key)
                );
                CREATE TABLE IF NOT EXISTS audit (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    created_at TEXT NOT NULL,
                    action TEXT NOT NULL,
                    subject TEXT NOT NULL,
                    details TEXT NOT NULL
                );
                CREATE TABLE IF NOT EXISTS conversations (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    created_at TEXT NOT NULL,
                    role TEXT NOT NULL,
                    content TEXT NOT NULL
                );
                """
            )

    def audit(self, action: str, subject: str, details: dict | None = None) -> None:
        with self._lock, self.connect() as db:
            db.execute(
                "INSERT INTO audit(created_at, action, subject, details) VALUES (?, ?, ?, ?)",
                (utc_now(), action, subject, json.dumps(details or {}, ensure_ascii=False)),
            )

    def list_tasks(self) -> list[dict]:
        with self._lock, self.connect() as db:
            rows = db.execute(
                "SELECT * FROM tasks ORDER BY created_at DESC LIMIT 200"
            ).fetchall()
        return [dict(row) for row in rows]

    def create_task(self, title: str, description: str, agent: str) -> dict:
        task_id = str(uuid.uuid4())
        now = utc_now()
        with self._lock, self.connect() as db:
            db.execute(
                """
                INSERT INTO tasks(
                    id, created_at, updated_at, title, description, status, agent
                ) VALUES (?, ?, ?, ?, ?, 'created', ?)
                """,
                (task_id, now, now, title, description, agent),
            )
        self.audit("task.created", task_id, {"title": title})
        return self.get_task(task_id)

    def get_task(self, task_id: str) -> dict:
        with self._lock, self.connect() as db:
            row = db.execute(
                "SELECT * FROM tasks WHERE id = ?", (task_id,)
            ).fetchone()
        if row is None:
            raise KeyError(task_id)
        return dict(row)

    def cancel_task(self, task_id: str) -> dict:
        with self._lock, self.connect() as db:
            row = db.execute(
                "SELECT status FROM tasks WHERE id = ?", (task_id,)
            ).fetchone()
            if row is None:
                raise KeyError(task_id)
            if row["status"] not in {"completed", "failed", "cancelled"}:
                db.execute(
                    "UPDATE tasks SET status='cancelled', updated_at=? WHERE id=?",
                    (utc_now(), task_id),
                )
        self.audit("task.cancelled", task_id)
        return self.get_task(task_id)

    def list_memory(self) -> list[dict]:
        with self._lock, self.connect() as db:
            rows = db.execute(
                """
                SELECT id, created_at, updated_at, category, key, value
                FROM memory
                ORDER BY category, key
                LIMIT 500
                """
            ).fetchall()
        return [dict(row) for row in rows]

    def set_memory(self, category: str, key: str, value: str) -> dict:
        now = utc_now()
        item_id = str(uuid.uuid4())
        with self._lock, self.connect() as db:
            db.execute(
                """
                INSERT INTO memory(id, created_at, updated_at, category, key, value)
                VALUES (?, ?, ?, ?, ?, ?)
                ON CONFLICT(category, key) DO UPDATE SET
                    updated_at=excluded.updated_at,
                    value=excluded.value
                """,
                (item_id, now, now, category, key, value),
            )
            row = db.execute(
                """
                SELECT id, created_at, updated_at, category, key, value
                FROM memory WHERE category=? AND key=?
                """,
                (category, key),
            ).fetchone()
        self.audit("memory.set", f"{category}/{key}")
        return dict(row)

    def list_audit(self) -> list[dict]:
        with self._lock, self.connect() as db:
            rows = db.execute(
                "SELECT * FROM audit ORDER BY id DESC LIMIT 200"
            ).fetchall()
        result = []
        for row in rows:
            item = dict(row)
            try:
                item["details"] = json.loads(item["details"])
            except json.JSONDecodeError:
                pass
            result.append(item)
        return result

    def save_conversation(self, role: str, content: str) -> None:
        with self._lock, self.connect() as db:
            db.execute(
                "INSERT INTO conversations(created_at, role, content) VALUES (?, ?, ?)",
                (utc_now(), role, content),
            )


def load_registry(path: Path, key: str) -> list[dict]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    value = data.get(key, [])
    return value if isinstance(value, list) else []


def select_model(models: list[dict], privacy: str, capability: str) -> dict | None:
    candidates = []
    for model in models:
        if not model.get("enabled", False):
            continue
        capabilities = model.get("capabilities", [])
        if capability and capability not in capabilities:
            continue
        allowed_privacy = model.get("privacy", ["normal"])
        if privacy not in allowed_privacy:
            continue
        candidates.append(model)
    candidates.sort(key=lambda item: int(item.get("priority", 100)))
    return candidates[0] if candidates else None


class Api:
    def __init__(self, settings: Settings) -> None:
        self.settings = settings
        self.store = Store(settings.database)

    def models(self) -> list[dict]:
        return load_registry(self.settings.models_file, "models")

    def tools(self) -> list[dict]:
        return load_registry(self.settings.tools_file, "tools")

    def status(self) -> dict:
        models = self.models()
        tools = self.tools()
        return {
            "service": "ai-control",
            "version": VERSION,
            "time": utc_now(),
            "primary_agent": {
                "name": self.settings.primary_agent,
                "status": "not_connected",
            },
            "models": {
                "configured": len(models),
                "enabled": sum(bool(item.get("enabled")) for item in models),
            },
            "tools": {
                "configured": len(tools),
                "available": sum(
                    item.get("status") == "available" for item in tools
                ),
            },
            "tasks": {
                "count": len(self.store.list_tasks()),
            },
            "database": str(self.settings.database),
        }


class Handler(BaseHTTPRequestHandler):
    server_version = "AIControl/0.1"

    @property
    def api(self) -> Api:
        return self.server.api  # type: ignore[attr-defined]

    def log_message(self, fmt: str, *args: object) -> None:
        sys.stderr.write(
            f"{self.address_string()} [{self.log_date_time_string()}] "
            f"{fmt % args}\n"
        )

    def send_json(self, payload: object, status: int = HTTPStatus.OK) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.security_headers()
        self.end_headers()
        self.wfile.write(body)

    def send_text(
        self,
        body: bytes,
        content_type: str,
        status: int = HTTPStatus.OK,
    ) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.security_headers()
        self.end_headers()
        self.wfile.write(body)

    def security_headers(self) -> None:
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header(
            "Content-Security-Policy",
            "default-src 'self'; style-src 'self' 'unsafe-inline'; "
            "script-src 'self' 'unsafe-inline'; connect-src 'self'",
        )
        self.send_header("Cache-Control", "no-store")

    def authorized(self) -> bool:
        header = self.headers.get("Authorization", "")
        if not header.startswith("Basic "):
            return False
        try:
            raw = base64.b64decode(header[6:], validate=True).decode("utf-8")
            username, password = raw.split(":", 1)
        except (ValueError, UnicodeDecodeError):
            return False
        return hmac.compare_digest(username, self.api.settings.web_user) and (
            hmac.compare_digest(password, self.api.settings.web_password)
        )

    def require_auth(self) -> bool:
        if self.authorized():
            return True
        self.send_response(HTTPStatus.UNAUTHORIZED)
        self.send_header("WWW-Authenticate", 'Basic realm="AI Control"')
        self.send_header("Content-Length", "0")
        self.security_headers()
        self.end_headers()
        return False

    def read_json(self) -> dict:
        raw_length = self.headers.get("Content-Length", "0")
        try:
            length = int(raw_length)
        except ValueError as exc:
            raise ValueError("Некорректный Content-Length") from exc
        if length <= 0 or length > MAX_BODY_BYTES:
            raise ValueError("Некорректный размер запроса")
        raw = self.rfile.read(length)
        try:
            data = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ValueError("Тело запроса должно быть JSON") from exc
        if not isinstance(data, dict):
            raise ValueError("JSON должен быть объектом")
        return data

    def do_GET(self) -> None:
        path = urlparse(self.path).path
        if path == "/health":
            self.send_json({"status": "ok", "version": VERSION})
            return
        if not self.require_auth():
            return

        if path in {"/", "/index.html"}:
            index = self.api.settings.web_root / "index.html"
            try:
                body = index.read_bytes()
            except OSError:
                self.send_json(
                    {"error": "web_ui_unavailable"},
                    HTTPStatus.SERVICE_UNAVAILABLE,
                )
                return
            self.send_text(body, "text/html; charset=utf-8")
            return
        if path == "/api/status":
            self.send_json(self.api.status())
            return
        if path == "/api/tasks":
            self.send_json({"tasks": self.api.store.list_tasks()})
            return
        if path == "/api/memory":
            self.send_json({"memory": self.api.store.list_memory()})
            return
        if path == "/api/models":
            self.send_json({"models": self.api.models()})
            return
        if path == "/api/tools":
            self.send_json({"tools": self.api.tools()})
            return
        if path == "/api/audit":
            self.send_json({"audit": self.api.store.list_audit()})
            return
        self.send_json({"error": "not_found"}, HTTPStatus.NOT_FOUND)

    def do_POST(self) -> None:
        path = urlparse(self.path).path
        if not self.require_auth():
            return
        try:
            data = self.read_json()
        except ValueError as exc:
            self.send_json({"error": str(exc)}, HTTPStatus.BAD_REQUEST)
            return

        if path == "/api/tasks":
            title = str(data.get("title", "")).strip()
            description = str(data.get("description", "")).strip()
            if not title:
                self.send_json(
                    {"error": "Поле title обязательно"},
                    HTTPStatus.BAD_REQUEST,
                )
                return
            task = self.api.store.create_task(
                title[:200],
                description[:10000],
                self.api.settings.primary_agent,
            )
            self.send_json(task, HTTPStatus.CREATED)
            return

        if path.startswith("/api/tasks/") and path.endswith("/cancel"):
            task_id = path.removeprefix("/api/tasks/").removesuffix("/cancel")
            try:
                task = self.api.store.cancel_task(task_id)
            except KeyError:
                self.send_json({"error": "task_not_found"}, HTTPStatus.NOT_FOUND)
                return
            self.send_json(task)
            return

        if path == "/api/memory":
            category = str(data.get("category", "")).strip()
            key = str(data.get("key", "")).strip()
            value = str(data.get("value", "")).strip()
            if not category or not key or not value:
                self.send_json(
                    {"error": "category, key и value обязательны"},
                    HTTPStatus.BAD_REQUEST,
                )
                return
            item = self.api.store.set_memory(
                category[:100],
                key[:200],
                value[:50000],
            )
            self.send_json(item, HTTPStatus.CREATED)
            return

        if path == "/api/models/select":
            privacy = str(data.get("privacy", "normal")).strip() or "normal"
            capability = str(data.get("capability", "chat")).strip() or "chat"
            selected = select_model(self.api.models(), privacy, capability)
            self.api.store.audit(
                "model.select",
                selected.get("id", "none") if selected else "none",
                {"privacy": privacy, "capability": capability},
            )
            self.send_json({"model": selected})
            return

        if path == "/api/chat":
            message = str(data.get("message", "")).strip()
            if not message:
                self.send_json(
                    {"error": "Поле message обязательно"},
                    HTTPStatus.BAD_REQUEST,
                )
                return
            self.api.store.save_conversation("user", message[:50000])
            response = (
                "Ядро AI Control работает, но основной агент Hermes ещё не "
                "подключён. Сообщение сохранено в истории."
            )
            self.api.store.save_conversation("system", response)
            self.api.store.audit("chat.agent_unavailable", "hermes")
            self.send_json(
                {
                    "status": "agent_unavailable",
                    "agent": self.api.settings.primary_agent,
                    "message": response,
                },
                HTTPStatus.SERVICE_UNAVAILABLE,
            )
            return

        self.send_json({"error": "not_found"}, HTTPStatus.NOT_FOUND)


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self, address: tuple[str, int], api: Api) -> None:
        super().__init__(address, Handler)
        self.api = api


def main() -> int:
    settings = Settings()
    api = Api(settings)
    server = Server((settings.listen, settings.port), api)
    print(
        f"AI Control {VERSION}: http://{settings.listen}:{settings.port}",
        flush=True,
    )
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
